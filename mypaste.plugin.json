{
  "manifestVersion": 3,
  "kind": "ui",
  "id": "com.mypaste.sql",
  "name": "SQL Toolkit",
  "version": "5.1.1",
  "description": "七种方言的 SQL 工作区，只在正文是 SQL 语句时出现：按 SQL Style Guide 美化（关键字大写、子句右对齐、可选目标行宽），编辑器高亮、语法问题列表与压缩都在页面内完成；解析不了的语句原样保留并标出位置，不执行 SQL、不联网；复制由宿主写入剪贴板。",
  "capabilities": [
    "entity.read",
    "clipboard.write"
  ],
  "surface": {
    "entry": "preview.html",
    "forms": [
      "text"
    ],
    "role": "open",
    "chrome": "page",
    "match": {
      "prefix": [
        "select",
        "insert into",
        "update",
        "delete from",
        "create table",
        "alter table",
        "drop table",
        "with"
      ],
      "contains": [
        "from",
        "where",
        "values",
        "insert into",
        "delete from",
        "create table",
        "alter table",
        "drop table"
      ],
      "ignoreCase": true,
      "minScore": 3
    }
  },
  "menus": [
    {
      "id": "sql.panel",
      "title": "SQL",
      "entry": "preview.html",
      "icon": "database",
      "order": 62
    }
  ]
}
